}

model AssistantEscalation {
  id               String                      @id @default(uuid()) @db.Uuid
  organisationId   String                      @db.Uuid
  locationId       String?                     @db.Uuid
  interactionId    String                      @unique @db.Uuid
  reference        String
  priority         AssistantEscalationPriority
  status           AssistantEscalationStatus   @default(OPEN)
  reasonCode       String
  questionRedacted String
  raisedById       String                      @db.Uuid
  assignedToId     String?                     @db.Uuid
  response         String?
  acknowledgedAt   DateTime?
  resolvedAt       DateTime?
  resolvedById     String?                     @db.Uuid
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  organisation Organisation      @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  location ServiceLocation?       @relation(fields: [locationId], references: [id], onDelete: Restrict)
  interaction AIInteractionLog    @relation(fields: [interactionId], references: [id], onDelete: Restrict)
  raisedBy User                   @relation("AssistantEscalationRaiser", fields: [raisedById], references: [id], onDelete: Restrict)
  assignedTo User?                @relation("AssistantEscalationAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  resolvedBy User?                @relation("AssistantEscalationResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([organisationId, reference])
  @@index([organisationId, status, priority, createdAt])
  @@index([locationId, status])
  @@index([assignedToId, status])
  @@index([raisedById, createdAt])
}

model ExternalIdentifier {
  id             String              @id @default(uuid()) @db.Uuid
  organisationId String              @db.Uuid
  connectionId   String?             @db.Uuid
  sourceSystem   String
  entityType     CanonicalEntityType
  externalId     String
  recordId       String              @db.Uuid
  lastSeenAt     DateTime?
  metadata       Json?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organisation Organisation          @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  connection IntegrationConnection?  @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@unique([organisationId, sourceSystem, entityType, externalId])
  @@unique([organisationId, sourceSystem, entityType, recordId])
  @@index([organisationId, entityType, recordId])
}

model ReconciliationCase {
  id                String                @id @default(uuid()) @db.Uuid
  organisationId    String                @db.Uuid
  locationId        String?               @db.Uuid
  reference         String
  fingerprint       String
  entityType        CanonicalEntityType
  reason            ReconciliationReason
  status            ReconciliationStatus @default(OPEN)
  candidateRecordIds String[]              @default([])
  candidateLabels   String[]              @default([])
  matchSignals      String[]              @default([])
  summary           String
  assignedToId      String?               @db.Uuid
  reviewedById      String?               @db.Uuid
  canonicalRecordId String?               @db.Uuid
  reviewNote        String?
  reviewedAt        DateTime?
  resolvedAt        DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  integrationEvents IntegrationEvent[]
  importRows ImportRow[]

  @@unique([organisationId, fingerprint])
  @@unique([organisationId, reference])
  @@index([organisationId, status, createdAt])
  @@index([locationId, status])
}

model MaterialChange {
  id                String                 @id @default(uuid()) @db.Uuid
  organisationId    String                 @db.Uuid
  locationId        String?                @db.Uuid
  carePlanId        String                 @db.Uuid
  carePlanVersionId String                 @db.Uuid
  carePlanChangeId  String                 @unique @db.Uuid
  clientId          String                 @db.Uuid
  category          MaterialChangeCategory
  severity          MaterialChangeSeverity
  sectionKey        String
  fieldPath         String
  previousValue     Json?
  proposedValue     Json?
  summary           String
  rationale         String
  status            MaterialChangeStatus   @default(PROPOSED)
  createdById       String                 @db.Uuid
  approvedById      String?                @db.Uuid
  approvedAt        DateTime?
  appliedAt         DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  carePlanChange CarePlanChange     @relation(fields: [carePlanChangeId], references: [id], onDelete: Cascade)
  dependencies  DependencyReview[]

  @@index([organisationId, status, severity])
  @@index([carePlanId, carePlanVersionId])
  @@index([clientId, status])
}

model DependencyReview {
  id               String                 @id @default(uuid()) @db.Uuid
  organisationId   String                 @db.Uuid
  locationId       String?                @db.Uuid
  materialChangeId String                 @db.Uuid
  type             DependencyReviewType
  targetRecordId   String?                @db.Uuid
  targetReference  String?
  targetTitle      String
  status           DependencyReviewStatus @default(OPEN)
  decision         String?
  reviewedById     String?                @db.Uuid
  reviewedAt       DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  materialChange MaterialChange @relation(fields: [materialChangeId], references: [id], onDelete: Cascade)

  @@unique([materialChangeId, type, targetTitle])
  @@index([organisationId, status, createdAt])
  @@index([locationId, status])
}
