model Organisation {
  id                       String    @id @default(uuid()) @db.Uuid
  name                     String
  slug                     String    @unique
  isDemo                   Boolean   @default(false)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  archivedAt               DateTime?
  licenceSeats             Int       @default(10)
  policyBrandName          String?
  policyRegistrationNumber String?
  policyAddress            String?
  policyEmail              String?
  policyPhone              String?
  policyWebsite            String?
  policyPrimaryColour      String    @default("#0f766e")
  policyFooterText         String?
  policyLogoStorageKey     String?
  policyLogoContentType    String?
  policyLogoFileName       String?
  policyLogoUploadedAt     DateTime?

  locations              ServiceLocation[]
  memberships            OrganisationMembership[]
  activities             ActivityLog[]
  policies               Policy[]
  evidenceItems          Evidence[]
  auditTemplates         AuditTemplate[]
  audits                 Audit[]
  registerDefinitions    RegisterDefinition[]
  registerEntries        RegisterEntry[]
  risks                  Risk[]
  actions                Action[]
  actionOccurrences      ActionOccurrence[]
  meetings               GovernanceMeeting[]
  calendarItems          CalendarItem[]
  calendarReminders      CalendarReminder[]
  kpiDefinitions         KpiDefinition[]
  kpiEntries             KpiEntry[]
  kpiReturns             KpiReturn[]
  complianceRequirements ComplianceRequirement[]
  templates              Template[]
  staffMembers           StaffMember[]
  staffComplianceRecords StaffComplianceRecord[]
  trainingCourses        TrainingCourse[]
  trainingRequirements   StaffTrainingRequirement[]
  staffLeaveRequests     StaffLeaveRequest[]
  clients                Client[]
  referenceCounters      ReferenceCounter[]
  managementDelegations  ManagementDelegation[]
  managementSavedViews   ManagementSavedView[]
  acknowledgementRequirements AcknowledgementRequirement[]
  understandingChecks    UnderstandingCheck[]
  careCompetencyRequirements CareCompetencyRequirement[]
  evidenceVerifications EvidenceVerification[]
  policyRequirementMappings PolicyRequirementMapping[]
  templateRequirementMappings TemplateRequirementMapping[]
  regulatoryFrameworkVersions RegulatoryFrameworkVersion[]
  frameworkChangeReviews FrameworkChangeReview[]
  mockInspections MockInspection[]
  externalParties ExternalParty[]
  externalDependencies ExternalDependency[]
  governanceDecisions GovernanceDecision[]
  governanceObligations GovernanceObligation[]
  integrationConnections IntegrationConnection[]
  integrationCredentials IntegrationCredential[]
  integrationEvents IntegrationEvent[]
  importBatches ImportBatch[]
  importRows ImportRow[]
  sourceAuthorities SourceAuthority[]
  offlineCaptures OfflineCapture[]
  externalIdentifiers ExternalIdentifier[]
  assistantInteractions AIInteractionLog[]
  assistantFeedback AssistantFeedback[]
  assistantEscalations AssistantEscalation[]
  configurationVersions TenantConfigurationVersion[]
  configurationPromotions ConfigurationPromotion[]
  notificationPreferences NotificationPreference[]
  implementationPlan ImplementationPlan?
  adoptionEvents ProductAdoptionEvent[]
  launchPilots LaunchPilot[]
  launchMeasures LaunchOutcomeMeasure[]
  serviceReadinessItems ServiceReadinessItem[]
  commercialIntentRecords CommercialIntentRecord[]
  benchmarkConsent BenchmarkConsent?
}

model ServiceLocation {
  id             String    @id @default(uuid()) @db.Uuid
  organisationId String    @db.Uuid
  name           String
  code           String
  addressLine1   String?
  town           String?
  postcode       String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  archivedAt     DateTime?

  organisation           Organisation            @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  assignments            MembershipLocation[]
  activities             ActivityLog[]
  evidenceItems          Evidence[]
  audits                 Audit[]
  registerEntries        RegisterEntry[]
  risks                  Risk[]
  actions                Action[]
  actionOccurrences      ActionOccurrence[]
  meetings               GovernanceMeeting[]
  calendarItems          CalendarItem[]
  kpiEntries             KpiEntry[]
  kpiReturns             KpiReturn[]
  complianceRequirements ComplianceRequirement[]
  staffMembers           StaffMember[]
  clients                Client[]
  managementDelegations  ManagementDelegation[]
  managementSavedViews   ManagementSavedView[]
  acknowledgementRequirements AcknowledgementRequirement[]
  understandingChecks    UnderstandingCheck[]
  careCompetencyRequirements CareCompetencyRequirement[]
  evidenceVerifications EvidenceVerification[]
  frameworkChangeReviews FrameworkChangeReview[]
  mockInspections MockInspection[]
  externalParties ExternalParty[]
  externalDependencies ExternalDependency[]
  governanceDecisions GovernanceDecision[]
  governanceObligations GovernanceObligation[]
  integrationConnections IntegrationConnection[]
  integrationEvents IntegrationEvent[]
  importBatches ImportBatch[]
  offlineCaptures OfflineCapture[]
  assistantInteractions AIInteractionLog[]
  assistantEscalations AssistantEscalation[]

  @@unique([organisationId, code])
  @@index([organisationId, isActive])
}

model User {
  id                    String    @id @default(uuid()) @db.Uuid
  email                 String    @unique
  name                  String
  passwordHash          String
  isActive              Boolean   @default(true)
  lastLoginAt           DateTime?
  mfaSecretCiphertext   String?
  mfaEnabledAt          DateTime?
  mfaRecoveryCodeHashes String[]  @default([])
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  memberships             OrganisationMembership[]
  sessions                Session[]
  activities              ActivityLog[]
  policiesOwned           Policy[]                 @relation("PolicyOwner")
  policiesCreated         Policy[]                 @relation("PolicyCreator")
  policiesApproved        Policy[]                 @relation("PolicyApprover")
  policyVersions          PolicyVersion[]
  evidenceOwned           Evidence[]               @relation("EvidenceOwner")
  evidenceUploaded        Evidence[]               @relation("EvidenceUploader")
  evidenceVersions        EvidenceVersion[]
  auditsPerformed         Audit[]                  @relation("AuditAuditor")
  auditsSignedOff         Audit[]                  @relation("AuditSignoff")
  registerEntriesOwned    RegisterEntry[]          @relation("RegisterEntryOwner")
  registerEntriesCreated  RegisterEntry[]          @relation("RegisterEntryCreator")
  registerHistory         RegisterEntryHistory[]
  risksOwned              Risk[]                   @relation("RiskOwner")
  risksCreated            Risk[]                   @relation("RiskCreator")
  risksApproved           Risk[]                   @relation("RiskClosureApprover")
  riskReviews             RiskReview[]
  actionsOwned            Action[]                 @relation("ActionOwner")
  actionsCreated          Action[]                 @relation("ActionCreator")
  actionsVerified         Action[]                 @relation("ActionVerifier")
  actionResponses         Action[]                 @relation("ActionManagementResponder")
  actionOccurrenceCreated ActionOccurrence[]       @relation("ActionOccurrenceCreator")
  actionOccurrenceDecided ActionOccurrence[]       @relation("ActionOccurrenceDecider")
  actionUpdates           ActionUpdate[]
  meetingsChaired         GovernanceMeeting[]      @relation("MeetingChair")
  meetingsCreated         GovernanceMeeting[]      @relation("MeetingCreator")
  meetingsApproved        GovernanceMeeting[]      @relation("MeetingApprover")
  meetingAttendance       MeetingAttendee[]
  calendarItemsOwned      CalendarItem[]           @relation("CalendarItemOwner")
  calendarItemsCreated    CalendarItem[]           @relation("CalendarItemCreator")
  calendarReminders       CalendarReminder[]
  kpiEntriesCreated       KpiEntry[]               @relation("KpiEntryCreator")
  kpiReturnsCreated       KpiReturn[]              @relation("KpiReturnCreator")
  kpiReturnsSubmitted     KpiReturn[]              @relation("KpiReturnSubmitter")
  inspectionOwned         ComplianceRequirement[]  @relation("InspectionOwner")
  inspectionCreated       ComplianceRequirement[]  @relation("InspectionCreator")
  inspectionReviewed      ComplianceRequirement[]  @relation("InspectionReviewer")
  inspectionSignedOff     ComplianceRequirement[]  @relation("InspectionSignoff")
  templatesAuthored       Template[]               @relation("TemplateAuthor")
  staffComplianceVerified StaffComplianceRecord[]  @relation("StaffComplianceVerifier")
  staffLeaveRequested     StaffLeaveRequest[]      @relation("StaffLeaveRequester")
  staffLeaveDecided       StaffLeaveRequest[]      @relation("StaffLeaveDecision")
  managementSavedViews    ManagementSavedView[]
  managementDelegationsCreated ManagementDelegation[] @relation("ManagementDelegationCreator")
  staffProfile            StaffMember?             @relation("StaffMemberUser")
  understandingCompleted UnderstandingCheck[]      @relation("UnderstandingCheckCompleter")
  understandingAssessed  UnderstandingCheck[]      @relation("UnderstandingCheckAssessor")
  competencyRequirementsCreated CareCompetencyRequirement[] @relation("CareCompetencyRequirementCreator")
  evidenceVerified       EvidenceVerification[]       @relation("EvidenceVerifier")
  evidenceMappingsCreated ComplianceRequirementEvidence[] @relation("EvidenceMappingCreator")
  policyMappingsCreated  PolicyRequirementMapping[]   @relation("PolicyRequirementMappingCreator")
  templateMappingsCreated TemplateRequirementMapping[] @relation("TemplateRequirementMappingCreator")
  frameworkVersionsCreated RegulatoryFrameworkVersion[] @relation("RegulatoryFrameworkCreator")
  frameworkReviewsOwned  FrameworkChangeReview[]      @relation("FrameworkReviewOwner")
  frameworkReviewsCompleted FrameworkChangeReview[]   @relation("FrameworkReviewCompleter")
  mockInspectionsLed     MockInspection[]              @relation("MockInspectionLead")
  mockInspectionsCreated MockInspection[]              @relation("MockInspectionCreator")
  mockSamplesReviewed    MockInspectionSample[]        @relation("MockInspectionSampleReviewer")
  externalDependenciesOwned ExternalDependency[]       @relation("ExternalDependencyOwner")
  governanceDecisionsOwned GovernanceDecision[]        @relation("GovernanceDecisionOwner")
  governanceDecisionsCreated GovernanceDecision[]      @relation("GovernanceDecisionCreator")
  governanceDecisionsImplemented GovernanceDecision[]  @relation("GovernanceDecisionImplementer")
  governanceDecisionsReviewed GovernanceDecision[]     @relation("GovernanceDecisionReviewer")
  governanceObligationsOwned GovernanceObligation[]     @relation("GovernanceObligationOwner")
  governanceObligationsCreated GovernanceObligation[]   @relation("GovernanceObligationCreator")
  governanceObligationUpdates GovernanceObligationUpdate[]
  integrationConnectionsOwned IntegrationConnection[] @relation("IntegrationConnectionOwner")
  integrationConnectionsCreated IntegrationConnection[] @relation("IntegrationConnectionCreator")
  integrationCredentialsCreated IntegrationCredential[] @relation("IntegrationCredentialCreator")
  importBatchesCreated ImportBatch[] @relation("ImportBatchCreator")
