model Organisation {
  id                       String    @id @default(uuid()) @db.Uuid
  name                     String
  slug                     String    @unique
  isDemo                   Boolean   @default(false)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  archivedAt               DateTime?
  licenceSeats             Int       @default(10)
  policyBrandName          String?
  policyRegistrationNumber String?
  policyAddress            String?
  policyEmail              String?
  policyPhone              String?
  policyWebsite            String?
  policyPrimaryColour      String    @default("#0f766e")
  policyFooterText         String?
  policyLogoStorageKey     String?
  policyLogoContentType    String?
  policyLogoFileName       String?
  policyLogoUploadedAt     DateTime?

  locations              ServiceLocation[]
  memberships            OrganisationMembership[]
  activities             ActivityLog[]
  policies               Policy[]
  evidenceItems          Evidence[]
  auditTemplates         AuditTemplate[]
  audits                 Audit[]
  registerDefinitions    RegisterDefinition[]
  registerEntries        RegisterEntry[]
  risks                  Risk[]
  actions                Action[]
  actionOccurrences      ActionOccurrence[]
  meetings               GovernanceMeeting[]
  calendarItems          CalendarItem[]
  calendarReminders      CalendarReminder[]
  kpiDefinitions         KpiDefinition[]
  kpiEntries             KpiEntry[]
  kpiReturns             KpiReturn[]
  complianceRequirements ComplianceRequirement[]
  templates              Template[]
  staffMembers           StaffMember[]
  staffComplianceRecords StaffComplianceRecord[]
  trainingCourses        TrainingCourse[]
  trainingRequirements   StaffTrainingRequirement[]
  staffLeaveRequests     StaffLeaveRequest[]
  clients                Client[]
  referenceCounters      ReferenceCounter[]
  managementDelegations  ManagementDelegation[]
  managementSavedViews   ManagementSavedView[]
}

model ServiceLocation {
  id             String    @id @default(uuid()) @db.Uuid
  organisationId String    @db.Uuid
  name           String
  code           String
  addressLine1   String?
  town           String?
  postcode       String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  archivedAt     DateTime?

  organisation           Organisation            @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  assignments            MembershipLocation[]
  activities             ActivityLog[]
  evidenceItems          Evidence[]
  audits                 Audit[]
  registerEntries        RegisterEntry[]
  risks                  Risk[]
  actions                Action[]
  actionOccurrences      ActionOccurrence[]
  meetings               GovernanceMeeting[]
  calendarItems          CalendarItem[]
  kpiEntries             KpiEntry[]
  kpiReturns             KpiReturn[]
  complianceRequirements ComplianceRequirement[]
  staffMembers           StaffMember[]
  clients                Client[]
  managementDelegations  ManagementDelegation[]
  managementSavedViews   ManagementSavedView[]

  @@unique([organisationId, code])
  @@index([organisationId, isActive])
}

model User {
  id                    String    @id @default(uuid()) @db.Uuid
  email                 String    @unique
  name                  String
  passwordHash          String
  isActive              Boolean   @default(true)
  lastLoginAt           DateTime?
  mfaSecretCiphertext   String?
  mfaEnabledAt          DateTime?
  mfaRecoveryCodeHashes String[]  @default([])
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  memberships             OrganisationMembership[]
  sessions                Session[]
  activities              ActivityLog[]
  policiesOwned           Policy[]                 @relation("PolicyOwner")
  policiesCreated         Policy[]                 @relation("PolicyCreator")
  policiesApproved        Policy[]                 @relation("PolicyApprover")
  policyVersions          PolicyVersion[]
  evidenceOwned           Evidence[]               @relation("EvidenceOwner")
  evidenceUploaded        Evidence[]               @relation("EvidenceUploader")
  evidenceVersions        EvidenceVersion[]
  auditsPerformed         Audit[]                  @relation("AuditAuditor")
  auditsSignedOff         Audit[]                  @relation("AuditSignoff")
  registerEntriesOwned    RegisterEntry[]          @relation("RegisterEntryOwner")
  registerEntriesCreated  RegisterEntry[]          @relation("RegisterEntryCreator")
  registerHistory         RegisterEntryHistory[]
  risksOwned              Risk[]                   @relation("RiskOwner")
  risksCreated            Risk[]                   @relation("RiskCreator")
  risksApproved           Risk[]                   @relation("RiskClosureApprover")
  riskReviews             RiskReview[]
  actionsOwned            Action[]                 @relation("ActionOwner")
  actionsCreated          Action[]                 @relation("ActionCreator")
  actionsVerified         Action[]                 @relation("ActionVerifier")
  actionResponses         Action[]                 @relation("ActionManagementResponder")
  actionOccurrenceCreated ActionOccurrence[]       @relation("ActionOccurrenceCreator")
  actionOccurrenceDecided ActionOccurrence[]       @relation("ActionOccurrenceDecider")
  actionUpdates           ActionUpdate[]
  meetingsChaired         GovernanceMeeting[]      @relation("MeetingChair")
  meetingsCreated         GovernanceMeeting[]      @relation("MeetingCreator")
  meetingsApproved        GovernanceMeeting[]      @relation("MeetingApprover")
  meetingAttendance       MeetingAttendee[]
  calendarItemsOwned      CalendarItem[]           @relation("CalendarItemOwner")
  calendarItemsCreated    CalendarItem[]           @relation("CalendarItemCreator")
  calendarReminders       CalendarReminder[]
  kpiEntriesCreated       KpiEntry[]               @relation("KpiEntryCreator")
  kpiReturnsCreated       KpiReturn[]              @relation("KpiReturnCreator")
  kpiReturnsSubmitted     KpiReturn[]              @relation("KpiReturnSubmitter")
  inspectionOwned         ComplianceRequirement[]  @relation("InspectionOwner")
  inspectionCreated       ComplianceRequirement[]  @relation("InspectionCreator")
  inspectionReviewed      ComplianceRequirement[]  @relation("InspectionReviewer")
  inspectionSignedOff     ComplianceRequirement[]  @relation("InspectionSignoff")
  templatesAuthored       Template[]               @relation("TemplateAuthor")
  staffComplianceVerified StaffComplianceRecord[]  @relation("StaffComplianceVerifier")
  staffLeaveRequested     StaffLeaveRequest[]      @relation("StaffLeaveRequester")
  staffLeaveDecided       StaffLeaveRequest[]      @relation("StaffLeaveDecision")
  managementSavedViews    ManagementSavedView[]
  managementDelegationsCreated ManagementDelegation[] @relation("ManagementDelegationCreator")
}

model Policy {
  id                 String               @id @default(uuid()) @db.Uuid
  organisationId     String               @db.Uuid
  title              String
  category           String
  ownerId            String               @db.Uuid
  currentVersionId   String?              @unique @db.Uuid
  effectiveDate      DateTime?
  lastReviewDate     DateTime?
  nextReviewDate     DateTime?
  approvalStatus     PolicyApprovalStatus @default(NOT_SUBMITTED)
  approvedById       String?              @db.Uuid
  approvedAt         DateTime?
  tags               String[]             @default([])
  complianceAreas    String[]             @default([])
  notes              String?
  templateKey        String?
  templateVersion    String?
  generatedSections  Json?
  sourceAnnex        Json?
  sourceCheckedAt    DateTime?
  customisationNotes String?
  updateAvailable    Boolean              @default(false)
  status             PolicyWorkflowStatus @default(DRAFT)
  archivedAt         DateTime?
  createdById        String               @db.Uuid
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  organisation   Organisation    @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  owner          User            @relation("PolicyOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdBy      User            @relation("PolicyCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy     User?           @relation("PolicyApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  currentVersion PolicyVersion?  @relation("CurrentPolicyVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions       PolicyVersion[] @relation("PolicyVersions")
  evidenceRecord Evidence?       @relation("GeneratedPolicyEvidence")

  @@index([organisationId, status])
  @@index([organisationId, nextReviewDate])
  @@index([organisationId, category])
  @@index([organisationId, templateKey])
}

model PolicyVersion {
  id            String   @id @default(uuid()) @db.Uuid
  policyId      String   @db.Uuid
  versionNumber String
  storageKey    String   @unique
  fileName      String
  contentType   String
  sizeBytes     Int
  checksum      String
  changeNotes   String?
  uploadedById  String   @db.Uuid
  createdAt     DateTime @default(now())

  policy     Policy  @relation("PolicyVersions", fields: [policyId], references: [id], onDelete: Cascade)
  currentFor Policy? @relation("CurrentPolicyVersion")
  uploadedBy User    @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@unique([policyId, versionNumber])
  @@index([policyId, createdAt])
}

model Evidence {
  id                         String                  @id @default(uuid()) @db.Uuid
  organisationId             String                  @db.Uuid
  locationId                 String?                 @db.Uuid
  title                      String
  description                String?
  category                   String
  evidenceType               String
  ownerId                    String                  @db.Uuid
  currentVersionId           String?                 @unique @db.Uuid
  evidenceDate               DateTime?
  reviewExpiryDate           DateTime?
  tags                       String[]                @default([])
  relatedModule              String?
  relatedRecordId            String?
  generatedPolicyId          String?                 @unique @db.Uuid
  generatedPolicyTemplateKey String?
  confidentiality            EvidenceConfidentiality @default(INTERNAL)
  status                     EvidenceWorkflowStatus  @default(ACTIVE)
  notes                      String?
  archivedAt                 DateTime?
  uploadedById               String                  @db.Uuid
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt

  organisation           Organisation                    @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  location               ServiceLocation?                @relation(fields: [locationId], references: [id], onDelete: Restrict)
  owner                  User                            @relation("EvidenceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  uploadedBy             User                            @relation("EvidenceUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  currentVersion         EvidenceVersion?                @relation("CurrentEvidenceVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions               EvidenceVersion[]               @relation("EvidenceVersions")
  auditResponses         AuditResponse[]
  registerLinks          RegisterEntryEvidence[]
  riskLinks              RiskEvidence[]
  actionLinks            ActionEvidence[]
  meetingLinks           MeetingEvidence[]
  kpiLinks               KpiEvidence[]
  inspectionLinks        ComplianceRequirementEvidence[]
  staffComplianceRecords StaffComplianceRecord[]
  actionUpdates          ActionUpdate[]
  actionOccurrences      ActionOccurrence[]
  generatedPolicy        Policy?                         @relation("GeneratedPolicyEvidence", fields: [generatedPolicyId], references: [id], onDelete: Cascade)

  @@unique([organisationId, generatedPolicyTemplateKey])
  @@index([organisationId, status])
  @@index([organisationId, category])
  @@index([organisationId, reviewExpiryDate])
  @@index([locationId])
}

model AuditTemplate {
  id              String   @id @default(uuid()) @db.Uuid
  organisationId  String?  @db.Uuid
  key             String
  name            String
  description     String?
  category        String   @default("Governance")
  standardRefs    String[] @default([])
  frequency       String?
  serviceSpecific Boolean  @default(false)
  version         String
  isPublished     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organisation Organisation?  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  sections     AuditSection[]
  audits       Audit[]

  @@unique([organisationId, name, version])
  @@unique([organisationId, key, version])
  @@index([organisationId, isPublished])
  @@index([category, isPublished])
}

model AuditSection {
  id          String  @id @default(uuid()) @db.Uuid
  templateId  String  @db.Uuid
  title       String
  description String?
  sortOrder   Int

  template  AuditTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  questions AuditQuestion[]

  @@unique([templateId, sortOrder])
}

model AuditQuestion {
  id                          String            @id @default(uuid()) @db.Uuid
  sectionId                   String            @db.Uuid
  text                        String
  guidance                    String?
  evidenceExpected            String?
  responseType                AuditQuestionType @default(COMPLIANCE)
  options                     String[]          @default([])
  weighting                   Int               @default(1)
  mandatory                   Boolean           @default(true)
  requiresCommentNonCompliant Boolean           @default(true)
  requiresEvidence            Boolean           @default(false)
  sortOrder                   Int

  section   AuditSection    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  responses AuditResponse[]

  @@unique([sectionId, sortOrder])
}

model Audit {
  id              String      @id @default(uuid()) @db.Uuid
  organisationId  String      @db.Uuid
  templateId      String      @db.Uuid
  templateVersion String
  auditorId       String      @db.Uuid
  locationId      String      @db.Uuid
  title           String
  auditDate       DateTime
  periodStart     DateTime?
  periodEnd       DateTime?
  scope           String?
  objective       String?
  sampleMethod    String?
  sampleSize      Int?
  sampleDetails   String?
  standardApplied String?
  limitations     String?
  status          AuditStatus @default(DRAFT)
  overallScore    Float?
  strengths       String?
  risks           String?
  recommendations String?
  signedOffById   String?     @db.Uuid
  signedOffAt     DateTime?
  reviewDate      DateTime?
  archivedAt      DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  organisation    Organisation                 @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  template        AuditTemplate                @relation(fields: [templateId], references: [id], onDelete: Restrict)
  auditor         User                         @relation("AuditAuditor", fields: [auditorId], references: [id], onDelete: Restrict)
  location        ServiceLocation              @relation(fields: [locationId], references: [id], onDelete: Restrict)
  signedOffBy     User?                        @relation("AuditSignoff", fields: [signedOffById], references: [id], onDelete: SetNull)
  responses       AuditResponse[]
  findings        AuditFinding[]
  inspectionLinks ComplianceRequirementAudit[]

  @@index([organisationId, status])
  @@index([organisationId, auditDate])
  @@index([locationId])
}

model AuditResponse {
  id         String   @id @default(uuid()) @db.Uuid
  auditId    String   @db.Uuid
  questionId String   @db.Uuid
  answer     String?
  comment    String?
  score      Float?
  evidenceId String?  @db.Uuid
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  audit    Audit         @relation(fields: [auditId], references: [id], onDelete: Cascade)
  question AuditQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)
  evidence Evidence?     @relation(fields: [evidenceId], references: [id], onDelete: SetNull)
  finding  AuditFinding?

  @@unique([auditId, questionId])
  @@index([evidenceId])
}

model AuditFinding {
  id             String          @id @default(uuid()) @db.Uuid
  auditId        String          @db.Uuid
  responseId     String          @unique @db.Uuid
  severity       FindingSeverity @default(MEDIUM)
  summary        String
  recommendation String?
  actionRequired Boolean         @default(false)
  resolvedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  audit    Audit         @relation(fields: [auditId], references: [id], onDelete: Cascade)
  response AuditResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@index([auditId, severity])
}

model RegisterDefinition {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String?  @db.Uuid
  key            String
  name           String
  description    String?
  fieldSchema    Json
  isPublished    Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation?   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  entries      RegisterEntry[]

  @@unique([organisationId, key])
  @@index([isPublished, sortOrder])
}

model RegisterEntry {
  id              String              @id @default(uuid()) @db.Uuid
  organisationId  String              @db.Uuid
  definitionId    String              @db.Uuid
  locationId      String?             @db.Uuid
  clientId        String?             @db.Uuid
  staffMemberId   String?             @db.Uuid
  reference       String
  eventDate       DateTime
  title           String
  summary         String
  riskLevel       RegisterRiskLevel   @default(LOW)
  status          RegisterEntryStatus @default(OPEN)
  ownerId         String?             @db.Uuid
  data            Json
  linkedActionIds String[]            @default([])
  closureDate     DateTime?
  archivedAt      DateTime?
