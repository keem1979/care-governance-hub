  updatedAt      DateTime            @updatedAt

  @@unique([organisationId, sourceSystem, entityType, externalId])
  @@unique([organisationId, sourceSystem, entityType, recordId])
  @@index([organisationId, entityType, recordId])
}

model ReconciliationCase {
  id                String                @id @default(uuid()) @db.Uuid
  organisationId    String                @db.Uuid
  locationId        String?               @db.Uuid
  reference         String
  fingerprint       String
  entityType        CanonicalEntityType
  reason            ReconciliationReason
  status            ReconciliationStatus @default(OPEN)
  candidateRecordIds String[]              @default([])
  candidateLabels   String[]              @default([])
  matchSignals      String[]              @default([])
  summary           String
  assignedToId      String?               @db.Uuid
  reviewedById      String?               @db.Uuid
  canonicalRecordId String?               @db.Uuid
  reviewNote        String?
  reviewedAt        DateTime?
  resolvedAt        DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@unique([organisationId, fingerprint])
  @@unique([organisationId, reference])
  @@index([organisationId, status, createdAt])
  @@index([locationId, status])
}

model MaterialChange {
  id                String                 @id @default(uuid()) @db.Uuid
  organisationId    String                 @db.Uuid
  locationId        String?                @db.Uuid
  carePlanId        String                 @db.Uuid
  carePlanVersionId String                 @db.Uuid
  carePlanChangeId  String                 @unique @db.Uuid
  clientId          String                 @db.Uuid
  category          MaterialChangeCategory
  severity          MaterialChangeSeverity
  sectionKey        String
  fieldPath         String
  previousValue     Json?
  proposedValue     Json?
  summary           String
  rationale         String
  status            MaterialChangeStatus   @default(PROPOSED)
  createdById       String                 @db.Uuid
  approvedById      String?                @db.Uuid
  approvedAt        DateTime?
  appliedAt         DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  carePlanChange CarePlanChange     @relation(fields: [carePlanChangeId], references: [id], onDelete: Cascade)
  dependencies  DependencyReview[]

  @@index([organisationId, status, severity])
  @@index([carePlanId, carePlanVersionId])
  @@index([clientId, status])
}

model DependencyReview {
  id               String                 @id @default(uuid()) @db.Uuid
  organisationId   String                 @db.Uuid
  locationId       String?                @db.Uuid
  materialChangeId String                 @db.Uuid
  type             DependencyReviewType
  targetRecordId   String?                @db.Uuid
  targetReference  String?
  targetTitle      String
  status           DependencyReviewStatus @default(OPEN)
  decision         String?
  reviewedById     String?                @db.Uuid
  reviewedAt       DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  materialChange MaterialChange @relation(fields: [materialChangeId], references: [id], onDelete: Cascade)

  @@unique([materialChangeId, type, targetTitle])
  @@index([organisationId, status, createdAt])
  @@index([locationId, status])
}
