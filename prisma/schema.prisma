generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "cloudflare"
}

datasource db {
  provider = "postgresql"
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum MembershipAccessMode {
  STANDARD
  READ_ONLY
}

enum ActivityAction {
  CREATE
  UPDATE
  ARCHIVE
  RESTORE
  LOGIN
  LOGIN_FAILED
  LOGOUT
  PERMISSION_CHANGE
  DOWNLOAD
  REPORT_GENERATION
  APPROVAL
  STATUS_CHANGE
  CLOSE
}

enum PolicyWorkflowStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  ARCHIVED
}

enum PolicyApprovalStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum EvidenceConfidentiality {
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
}

enum EvidenceWorkflowStatus {
  ACTIVE
  ARCHIVED
}

enum AuditQuestionType {
  COMPLIANCE
  YES_NO
  TEXT
  NUMBER
  DATE
  FILE
  MULTIPLE_CHOICE
}

enum AuditStatus {
  DRAFT
  IN_PROGRESS
  AWAITING_REVIEW
  COMPLETED
  CLOSED
  ARCHIVED
}

enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RegisterEntryStatus {
  OPEN
  IN_REVIEW
  AWAITING_ACTION
  CLOSED
  ARCHIVED
}

enum RegisterRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RiskStatus {
  OPEN
  MONITORING
  TREATMENT_IN_PROGRESS
  ACCEPTED
  CLOSED
  ARCHIVED
}

enum RiskLevel {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

enum ActionStatus {
  OPEN
  IN_PROGRESS
  AWAITING_EVIDENCE
  AWAITING_VERIFICATION
  COMPLETED
  OVERDUE
  CANCELLED
  ARCHIVED
}

enum ActionPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ActionSourceType {
  AUDIT
  COMPLAINT
  INCIDENT
  SAFEGUARDING
  RISK
  GOVERNANCE_MEETING
  POLICY_REVIEW
  MANUAL
}

enum MeetingStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  AWAITING_APPROVAL
  APPROVED
  CANCELLED
  ARCHIVED
}

enum MeetingAttendance {
  ATTENDING
  ATTENDED
  APOLOGY
  ABSENT
}

enum CalendarItemStatus {
  PENDING
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum CalendarItemType {
  CERTIFICATE_EXPIRY
  INSURANCE_EXPIRY
  TRAINING_EXPIRY
  SUPERVISION_DEADLINE
  APPRAISAL_DEADLINE
  SERVICE_REVIEW
  BUSINESS_CONTINUITY_TEST
  OTHER
}

enum KpiDirection {
  HIGHER_IS_BETTER
  LOWER_IS_BETTER
}

enum KpiRagStatus {
  GREEN
  AMBER
  RED
}

enum CqcKeyQuestion {
  SAFE
  EFFECTIVE
  CARING
  RESPONSIVE
  WELL_LED
}

enum InspectionEvidenceStatus {
  NO_EVIDENCE
  LIMITED_EVIDENCE
  EVIDENCE_AVAILABLE
  EVIDENCE_REVIEWED
  IMPROVEMENT_REQUIRED
}

enum TemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum StaffEmploymentStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  LEFT
}

enum StaffComplianceType {
  DBS
  RIGHT_TO_WORK
  VISA
  PROFESSIONAL_REGISTRATION
  TRAINING
  COMPETENCY
  SUPERVISION
  APPRAISAL
  SPOT_CHECK
  INFORMATION_GOVERNANCE
  OTHER
}

enum StaffComplianceOutcome {
  VALID
  PENDING
  COMPETENT
  DEVELOPMENT_REQUIRED
  NOT_APPLICABLE
}

model Organisation {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  slug         String    @unique
  isDemo       Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  archivedAt   DateTime?
  licenceSeats Int       @default(10)

  locations              ServiceLocation[]
  memberships            OrganisationMembership[]
  activities             ActivityLog[]
  policies               Policy[]
  evidenceItems          Evidence[]
  auditTemplates         AuditTemplate[]
  audits                 Audit[]
  registerDefinitions    RegisterDefinition[]
  registerEntries        RegisterEntry[]
  risks                  Risk[]
  actions                Action[]
  meetings               GovernanceMeeting[]
  calendarItems          CalendarItem[]
  calendarReminders      CalendarReminder[]
  kpiDefinitions         KpiDefinition[]
  kpiEntries             KpiEntry[]
  complianceRequirements ComplianceRequirement[]
  templates              Template[]
  staffMembers           StaffMember[]
  staffComplianceRecords StaffComplianceRecord[]
}

model ServiceLocation {
  id             String    @id @default(uuid()) @db.Uuid
  organisationId String    @db.Uuid
  name           String
  code           String
  addressLine1   String?
  town           String?
  postcode       String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  archivedAt     DateTime?

  organisation           Organisation            @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  assignments            MembershipLocation[]
  activities             ActivityLog[]
  evidenceItems          Evidence[]
  audits                 Audit[]
  registerEntries        RegisterEntry[]
  risks                  Risk[]
  actions                Action[]
  meetings               GovernanceMeeting[]
  calendarItems          CalendarItem[]
  kpiEntries             KpiEntry[]
  complianceRequirements ComplianceRequirement[]
  staffMembers           StaffMember[]

  @@unique([organisationId, code])
  @@index([organisationId, isActive])
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  name         String
  passwordHash String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  memberships             OrganisationMembership[]
  sessions                Session[]
  activities              ActivityLog[]
  policiesOwned           Policy[]                 @relation("PolicyOwner")
  policiesCreated         Policy[]                 @relation("PolicyCreator")
  policiesApproved        Policy[]                 @relation("PolicyApprover")
  policyVersions          PolicyVersion[]
  evidenceOwned           Evidence[]               @relation("EvidenceOwner")
  evidenceUploaded        Evidence[]               @relation("EvidenceUploader")
  evidenceVersions        EvidenceVersion[]
  auditsPerformed         Audit[]                  @relation("AuditAuditor")
  auditsSignedOff         Audit[]                  @relation("AuditSignoff")
  registerEntriesOwned    RegisterEntry[]          @relation("RegisterEntryOwner")
  registerEntriesCreated  RegisterEntry[]          @relation("RegisterEntryCreator")
  registerHistory         RegisterEntryHistory[]
  risksOwned              Risk[]                   @relation("RiskOwner")
  risksCreated            Risk[]                   @relation("RiskCreator")
  risksApproved           Risk[]                   @relation("RiskClosureApprover")
  riskReviews             RiskReview[]
  actionsOwned            Action[]                 @relation("ActionOwner")
  actionsCreated          Action[]                 @relation("ActionCreator")
  actionsVerified         Action[]                 @relation("ActionVerifier")
  actionUpdates           ActionUpdate[]
  meetingsChaired         GovernanceMeeting[]      @relation("MeetingChair")
  meetingsCreated         GovernanceMeeting[]      @relation("MeetingCreator")
  meetingsApproved        GovernanceMeeting[]      @relation("MeetingApprover")
  meetingAttendance       MeetingAttendee[]
  calendarItemsOwned      CalendarItem[]           @relation("CalendarItemOwner")
  calendarItemsCreated    CalendarItem[]           @relation("CalendarItemCreator")
  calendarReminders       CalendarReminder[]
  kpiEntriesCreated       KpiEntry[]               @relation("KpiEntryCreator")
  inspectionOwned         ComplianceRequirement[]  @relation("InspectionOwner")
  inspectionCreated       ComplianceRequirement[]  @relation("InspectionCreator")
  templatesAuthored       Template[]               @relation("TemplateAuthor")
  staffComplianceVerified StaffComplianceRecord[]  @relation("StaffComplianceVerifier")
}

model Policy {
  id               String               @id @default(uuid()) @db.Uuid
  organisationId   String               @db.Uuid
  title            String
  category         String
  ownerId          String               @db.Uuid
  currentVersionId String?              @unique @db.Uuid
  effectiveDate    DateTime?
  lastReviewDate   DateTime?
  nextReviewDate   DateTime?
  approvalStatus   PolicyApprovalStatus @default(NOT_SUBMITTED)
  approvedById     String?              @db.Uuid
  approvedAt       DateTime?
  tags             String[]             @default([])
  complianceAreas  String[]             @default([])
  notes            String?
  status           PolicyWorkflowStatus @default(DRAFT)
  archivedAt       DateTime?
  createdById      String               @db.Uuid
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  organisation   Organisation    @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  owner          User            @relation("PolicyOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdBy      User            @relation("PolicyCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy     User?           @relation("PolicyApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  currentVersion PolicyVersion?  @relation("CurrentPolicyVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions       PolicyVersion[] @relation("PolicyVersions")

  @@index([organisationId, status])
  @@index([organisationId, nextReviewDate])
  @@index([organisationId, category])
}

model PolicyVersion {
  id            String   @id @default(uuid()) @db.Uuid
  policyId      String   @db.Uuid
  versionNumber String
  storageKey    String   @unique
  fileName      String
  contentType   String
  sizeBytes     Int
  checksum      String
  changeNotes   String?
  uploadedById  String   @db.Uuid
  createdAt     DateTime @default(now())

  policy     Policy  @relation("PolicyVersions", fields: [policyId], references: [id], onDelete: Cascade)
  currentFor Policy? @relation("CurrentPolicyVersion")
  uploadedBy User    @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@unique([policyId, versionNumber])
  @@index([policyId, createdAt])
}

model Evidence {
  id               String                  @id @default(uuid()) @db.Uuid
  organisationId   String                  @db.Uuid
  locationId       String?                 @db.Uuid
  title            String
  description      String?
  category         String
  evidenceType     String
  ownerId          String                  @db.Uuid
  currentVersionId String?                 @unique @db.Uuid
  evidenceDate     DateTime?
  reviewExpiryDate DateTime?
  tags             String[]                @default([])
  relatedModule    String?
  relatedRecordId  String?
  confidentiality  EvidenceConfidentiality @default(INTERNAL)
  status           EvidenceWorkflowStatus  @default(ACTIVE)
  notes            String?
  archivedAt       DateTime?
  uploadedById     String                  @db.Uuid
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  organisation    Organisation                    @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  location        ServiceLocation?                @relation(fields: [locationId], references: [id], onDelete: Restrict)
  owner           User                            @relation("EvidenceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  uploadedBy      User                            @relation("EvidenceUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  currentVersion  EvidenceVersion?                @relation("CurrentEvidenceVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions        EvidenceVersion[]               @relation("EvidenceVersions")
  auditResponses  AuditResponse[]
  registerLinks   RegisterEntryEvidence[]
  riskLinks       RiskEvidence[]
  actionLinks     ActionEvidence[]
  meetingLinks    MeetingEvidence[]
  kpiLinks        KpiEvidence[]
  inspectionLinks ComplianceRequirementEvidence[]

  @@index([organisationId, status])
  @@index([organisationId, category])
  @@index([organisationId, reviewExpiryDate])
  @@index([locationId])
}

model AuditTemplate {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String?  @db.Uuid
  name           String
  description    String?
  version        String
  isPublished    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation?  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  sections     AuditSection[]
  audits       Audit[]

  @@unique([organisationId, name, version])
  @@index([organisationId, isPublished])
}

model AuditSection {
  id          String  @id @default(uuid()) @db.Uuid
  templateId  String  @db.Uuid
  title       String
  description String?
  sortOrder   Int

  template  AuditTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  questions AuditQuestion[]

  @@unique([templateId, sortOrder])
}

model AuditQuestion {
  id                          String            @id @default(uuid()) @db.Uuid
  sectionId                   String            @db.Uuid
  text                        String
  guidance                    String?
  evidenceExpected            String?
  responseType                AuditQuestionType @default(COMPLIANCE)
  options                     String[]          @default([])
  weighting                   Int               @default(1)
  mandatory                   Boolean           @default(true)
  requiresCommentNonCompliant Boolean           @default(true)
  requiresEvidence            Boolean           @default(false)
  sortOrder                   Int

  section   AuditSection    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  responses AuditResponse[]

  @@unique([sectionId, sortOrder])
}

model Audit {
  id              String      @id @default(uuid()) @db.Uuid
  organisationId  String      @db.Uuid
  templateId      String      @db.Uuid
  templateVersion String
  auditorId       String      @db.Uuid
  locationId      String      @db.Uuid
  title           String
  auditDate       DateTime
  periodStart     DateTime?
  periodEnd       DateTime?
  scope           String?
  status          AuditStatus @default(DRAFT)
  overallScore    Float?
  strengths       String?
  risks           String?
  recommendations String?
  signedOffById   String?     @db.Uuid
  signedOffAt     DateTime?
  reviewDate      DateTime?
  archivedAt      DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  organisation    Organisation                 @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  template        AuditTemplate                @relation(fields: [templateId], references: [id], onDelete: Restrict)
  auditor         User                         @relation("AuditAuditor", fields: [auditorId], references: [id], onDelete: Restrict)
  location        ServiceLocation              @relation(fields: [locationId], references: [id], onDelete: Restrict)
  signedOffBy     User?                        @relation("AuditSignoff", fields: [signedOffById], references: [id], onDelete: SetNull)
  responses       AuditResponse[]
  findings        AuditFinding[]
  inspectionLinks ComplianceRequirementAudit[]

  @@index([organisationId, status])
  @@index([organisationId, auditDate])
  @@index([locationId])
}

model AuditResponse {
  id         String   @id @default(uuid()) @db.Uuid
  auditId    String   @db.Uuid
  questionId String   @db.Uuid
  answer     String?
  comment    String?
  score      Float?
  evidenceId String?  @db.Uuid
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  audit    Audit         @relation(fields: [auditId], references: [id], onDelete: Cascade)
  question AuditQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)
  evidence Evidence?     @relation(fields: [evidenceId], references: [id], onDelete: SetNull)
  finding  AuditFinding?

  @@unique([auditId, questionId])
  @@index([evidenceId])
}

model AuditFinding {
  id             String          @id @default(uuid()) @db.Uuid
  auditId        String          @db.Uuid
  responseId     String          @unique @db.Uuid
  severity       FindingSeverity @default(MEDIUM)
  summary        String
  recommendation String?
  actionRequired Boolean         @default(false)
  resolvedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  audit    Audit         @relation(fields: [auditId], references: [id], onDelete: Cascade)
  response AuditResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@index([auditId, severity])
}

model RegisterDefinition {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String?  @db.Uuid
  key            String
  name           String
  description    String?
  fieldSchema    Json
  isPublished    Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation?   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  entries      RegisterEntry[]

  @@unique([organisationId, key])
  @@index([isPublished, sortOrder])
}

model RegisterEntry {
  id              String              @id @default(uuid()) @db.Uuid
  organisationId  String              @db.Uuid
  definitionId    String              @db.Uuid
  locationId      String?             @db.Uuid
  reference       String
  eventDate       DateTime
  title           String
  summary         String
  riskLevel       RegisterRiskLevel   @default(LOW)
  status          RegisterEntryStatus @default(OPEN)
  ownerId         String?             @db.Uuid
  data            Json
  linkedActionIds String[]            @default([])
  closureDate     DateTime?
  archivedAt      DateTime?
  createdById     String              @db.Uuid
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  organisation    Organisation                    @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  definition      RegisterDefinition              @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  location        ServiceLocation?                @relation(fields: [locationId], references: [id], onDelete: Restrict)
  owner           User?                           @relation("RegisterEntryOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy       User                            @relation("RegisterEntryCreator", fields: [createdById], references: [id], onDelete: Restrict)
  evidenceLinks   RegisterEntryEvidence[]
  history         RegisterEntryHistory[]
  inspectionLinks ComplianceRequirementRegister[]

  @@unique([organisationId, definitionId, reference])
  @@index([organisationId, definitionId, status])
  @@index([locationId, eventDate])
}

model RegisterEntryEvidence {
  entryId    String @db.Uuid
  evidenceId String @db.Uuid

  entry    RegisterEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  evidence Evidence      @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@id([entryId, evidenceId])
  @@index([evidenceId])
}

model RegisterEntryHistory {
  id        String   @id @default(uuid()) @db.Uuid
  entryId   String   @db.Uuid
  userId    String?  @db.Uuid
  action    String
  snapshot  Json
  createdAt DateTime @default(now())

  entry RegisterEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user  User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entryId, createdAt])
}

model Risk {
  id                  String     @id @default(uuid()) @db.Uuid
  organisationId      String     @db.Uuid
  locationId          String?    @db.Uuid
  reference           String
  title               String
  description         String
  category            String
  existingControls    String
  likelihood          Int
  impact              Int
  initialScore        Int
  initialLevel        RiskLevel
  furtherControls     String?
  ownerId             String?    @db.Uuid
  targetDate          DateTime?
  residualLikelihood  Int
  residualImpact      Int
  residualScore       Int
  residualLevel       RiskLevel
  reviewFrequency     String
  lastReviewDate      DateTime?
  nextReviewDate      DateTime
  status              RiskStatus @default(OPEN)
  closureRationale    String?
  closureApprovedById String?    @db.Uuid
  closureDate         DateTime?
  archivedAt          DateTime?
  createdById         String     @db.Uuid
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  organisation      Organisation     @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  location          ServiceLocation? @relation(fields: [locationId], references: [id], onDelete: Restrict)
  owner             User?            @relation("RiskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy         User             @relation("RiskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  closureApprovedBy User?            @relation("RiskClosureApprover", fields: [closureApprovedById], references: [id], onDelete: SetNull)
  evidenceLinks     RiskEvidence[]
  reviews           RiskReview[]

  @@unique([organisationId, reference])
  @@index([organisationId, status, residualLevel])
  @@index([organisationId, nextReviewDate])
  @@index([locationId])
}

model RiskEvidence {
  riskId     String @db.Uuid
  evidenceId String @db.Uuid

  risk     Risk     @relation(fields: [riskId], references: [id], onDelete: Cascade)
  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@id([riskId, evidenceId])
  @@index([evidenceId])
}

model RiskReview {
  id                String    @id @default(uuid()) @db.Uuid
  riskId            String    @db.Uuid
  reviewedById      String    @db.Uuid
  reviewDate        DateTime
  notes             String
  likelihood        Int
  impact            Int
  score             Int
  level             RiskLevel
  controlsEffective Boolean
  nextReviewDate    DateTime
  createdAt         DateTime  @default(now())

  risk       Risk @relation(fields: [riskId], references: [id], onDelete: Cascade)
  reviewedBy User @relation(fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([riskId, reviewDate])
}

model Action {
  id                        String           @id @default(uuid()) @db.Uuid
  organisationId            String           @db.Uuid
  locationId                String?          @db.Uuid
  reference                 String
  title                     String
  description               String
  sourceType                ActionSourceType
  sourceRecordId            String?          @db.Uuid
  sourceReference           String?
  ownerId                   String           @db.Uuid
  priority                  ActionPriority   @default(MEDIUM)
  dueDate                   DateTime
  status                    ActionStatus     @default(OPEN)
  progressNote              String?
  evidenceRequired          Boolean          @default(true)
  evidenceWaiverExplanation String?
  completionDate            DateTime?
  verifiedById              String?          @db.Uuid
  verificationDate          DateTime?
  closureNote               String?
  archivedAt                DateTime?
  createdById               String           @db.Uuid
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt

  organisation    Organisation                  @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  location        ServiceLocation?              @relation(fields: [locationId], references: [id], onDelete: Restrict)
  owner           User                          @relation("ActionOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdBy       User                          @relation("ActionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  verifiedBy      User?                         @relation("ActionVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  updates         ActionUpdate[]
  evidenceLinks   ActionEvidence[]
  inspectionLinks ComplianceRequirementAction[]

  @@unique([organisationId, reference])
  @@index([organisationId, status, priority])
  @@index([organisationId, dueDate])
  @@index([ownerId, status])
  @@index([locationId])
  @@index([sourceType, sourceRecordId])
}

model ActionUpdate {
  id        String        @id @default(uuid()) @db.Uuid
  actionId  String        @db.Uuid
  userId    String        @db.Uuid
  note      String
  status    ActionStatus?
  createdAt DateTime      @default(now())

  action Action @relation(fields: [actionId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([actionId, createdAt])
}

model ActionEvidence {
  actionId   String @db.Uuid
  evidenceId String @db.Uuid

  action   Action   @relation(fields: [actionId], references: [id], onDelete: Cascade)
  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@id([actionId, evidenceId])
  @@index([evidenceId])
}

model GovernanceMeeting {
  id                 String        @id @default(uuid()) @db.Uuid
  organisationId     String        @db.Uuid
  locationId         String?       @db.Uuid
  reference          String
  title              String
  meetingType        String
  meetingDate        DateTime
  meetingTime        String
  locationOrLink     String
  chairId            String        @db.Uuid
  reportingPeriod    String?
  previousActionIds  String[]      @default([])
  kpiReview          String?
  auditFindings      String?
  complaints         String?
  incidents          String?
  safeguarding       String?
  workforce          String?
  risks              String?
  qualityImprovement String?
  decisions          String?
  minutes            String?
  status             MeetingStatus @default(DRAFT)
  approvedById       String?       @db.Uuid
  approvalDate       DateTime?
  nextMeetingDate    DateTime?
  archivedAt         DateTime?
  createdById        String        @db.Uuid
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  organisation  Organisation        @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  location      ServiceLocation?    @relation(fields: [locationId], references: [id], onDelete: Restrict)
  chair         User                @relation("MeetingChair", fields: [chairId], references: [id], onDelete: Restrict)
  createdBy     User                @relation("MeetingCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy    User?               @relation("MeetingApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  attendees     MeetingAttendee[]
  agendaItems   MeetingAgendaItem[]
  evidenceLinks MeetingEvidence[]

  @@unique([organisationId, reference])
  @@index([organisationId, status, meetingDate])
  @@index([locationId])
  @@index([chairId])
}

model MeetingAttendee {
  meetingId  String            @db.Uuid
  userId     String            @db.Uuid
  attendance MeetingAttendance @default(ATTENDING)

  meeting GovernanceMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User              @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([meetingId, userId])
  @@index([userId])
}

model MeetingAgendaItem {
  id             String   @id @default(uuid()) @db.Uuid
  meetingId      String   @db.Uuid
  topic          String
  title          String
  notes          String?
  decision       String?
  linkedActionId String?  @db.Uuid
  sortOrder      Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  meeting GovernanceMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([meetingId, sortOrder])
  @@index([meetingId])
  @@index([linkedActionId])
}

model MeetingEvidence {
  meetingId  String @db.Uuid
  evidenceId String @db.Uuid

  meeting  GovernanceMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  evidence Evidence          @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@id([meetingId, evidenceId])
  @@index([evidenceId])
}

model CalendarItem {
  id             String             @id @default(uuid()) @db.Uuid
  organisationId String             @db.Uuid
  locationId     String?            @db.Uuid
  title          String
  description    String?
  itemType       CalendarItemType
  dueDate        DateTime
  ownerId        String?            @db.Uuid
  riskLevel      String?
  status         CalendarItemStatus @default(PENDING)
  archivedAt     DateTime?
  createdById    String             @db.Uuid
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organisation Organisation     @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  location     ServiceLocation? @relation(fields: [locationId], references: [id], onDelete: Restrict)
  owner        User?            @relation("CalendarItemOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy    User             @relation("CalendarItemCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([organisationId, dueDate, status])
  @@index([locationId])
  @@index([ownerId])
}

model CalendarReminder {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @db.Uuid
  userId         String   @db.Uuid
  eventKey       String
  offsetDays     Int
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventKey, offsetDays])
  @@index([organisationId, userId])
}

model KpiDefinition {
  id             String       @id @default(uuid()) @db.Uuid
  organisationId String       @db.Uuid
  name           String
  slug           String
  description    String?
  unit           String
  direction      KpiDirection
  targetValue    Float
  greenThreshold Float
  amberThreshold Float
  sortOrder      Int
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  entries      KpiEntry[]

  @@unique([organisationId, slug])
  @@index([organisationId, isActive, sortOrder])
}

model KpiEntry {
  id             String       @id @default(uuid()) @db.Uuid
  organisationId String       @db.Uuid
  locationId     String?      @db.Uuid
  kpiId          String       @db.Uuid
  reportingMonth DateTime
  actualValue    Float
  targetValue    Float
  greenThreshold Float
  amberThreshold Float
  ragStatus      KpiRagStatus
  notes          String?
  createdById    String       @db.Uuid
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organisation  Organisation     @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  location      ServiceLocation? @relation(fields: [locationId], references: [id], onDelete: Restrict)
  kpi           KpiDefinition    @relation(fields: [kpiId], references: [id], onDelete: Restrict)
  createdBy     User             @relation("KpiEntryCreator", fields: [createdById], references: [id], onDelete: Restrict)
  evidenceLinks KpiEvidence[]

  @@unique([kpiId, locationId, reportingMonth])
  @@index([organisationId, reportingMonth, ragStatus])
  @@index([locationId, reportingMonth])
}

model KpiEvidence {
  entryId    String @db.Uuid
  evidenceId String @db.Uuid

  entry    KpiEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@id([entryId, evidenceId])
  @@index([evidenceId])
}

model ComplianceRequirement {
  id               String                   @id @default(uuid()) @db.Uuid
  organisationId   String                   @db.Uuid
  locationId       String?                  @db.Uuid
  keyQuestion      CqcKeyQuestion
  qualityStatement String?
  title            String
  explanation      String
  evidenceExamples String[]                 @default([])
  ownerId          String?                  @db.Uuid
  reviewDate       DateTime?
  evidenceStatus   InspectionEvidenceStatus @default(NO_EVIDENCE)
  confidenceNote   String?
  createdById      String                   @db.Uuid
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  organisation  Organisation                    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  location      ServiceLocation?                @relation(fields: [locationId], references: [id], onDelete: Restrict)
  owner         User?                           @relation("InspectionOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdBy     User                            @relation("InspectionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  evidenceLinks ComplianceRequirementEvidence[]
  auditLinks    ComplianceRequirementAudit[]
  registerLinks ComplianceRequirementRegister[]
  actionLinks   ComplianceRequirementAction[]

  @@index([organisationId, keyQuestion, evidenceStatus])
  @@index([organisationId, reviewDate])
  @@index([locationId])
  @@index([ownerId])
}

model ComplianceRequirementEvidence {
  requirementId String @db.Uuid
  evidenceId    String @db.Uuid

  requirement ComplianceRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  evidence    Evidence              @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@id([requirementId, evidenceId])
  @@index([evidenceId])
}

model ComplianceRequirementAudit {
  requirementId String @db.Uuid
  auditId       String @db.Uuid

  requirement ComplianceRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  audit       Audit                 @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@id([requirementId, auditId])
  @@index([auditId])
}

model ComplianceRequirementRegister {
  requirementId   String @db.Uuid
  registerEntryId String @db.Uuid

  requirement   ComplianceRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  registerEntry RegisterEntry         @relation(fields: [registerEntryId], references: [id], onDelete: Cascade)

  @@id([requirementId, registerEntryId])
  @@index([registerEntryId])
}

model ComplianceRequirementAction {
  requirementId String @db.Uuid
  actionId      String @db.Uuid

  requirement ComplianceRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  action      Action                @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@id([requirementId, actionId])
  @@index([actionId])
}

model Template {
  id             String         @id @default(uuid()) @db.Uuid
  organisationId String?        @db.Uuid
  title          String
  category       String
  description    String
  version        String
  reviewDate     DateTime?
  authorId       String?        @db.Uuid
  tags           String[]       @default([])
  status         TemplateStatus @default(PUBLISHED)
  fileName       String
  contentType    String
  sizeBytes      Int
  checksum       String
  storageKey     String?        @unique
  bodyText       String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  author       User?         @relation("TemplateAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([organisationId, category, status])
  @@index([title])
}

model StaffMember {
  id                String                @id @default(uuid()) @db.Uuid
  organisationId    String                @db.Uuid
  locationId        String?               @db.Uuid
  employeeReference String
  firstName         String
  lastName          String
  jobTitle          String
  department        String?
  startDate         DateTime?
  endDate           DateTime?
  employmentStatus  StaffEmploymentStatus @default(ACTIVE)
  lineManager       String?
  notes             String?
  archivedAt        DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  organisation Organisation            @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  location     ServiceLocation?        @relation(fields: [locationId], references: [id], onDelete: Restrict)
  records      StaffComplianceRecord[]

  @@unique([organisationId, employeeReference])
  @@index([organisationId, employmentStatus])
  @@index([locationId])
}

model StaffComplianceRecord {
  id             String                 @id @default(uuid()) @db.Uuid
  organisationId String                 @db.Uuid
  staffMemberId  String                 @db.Uuid
  type           StaffComplianceType
  title          String
  reference      String?
  completedDate  DateTime?
  expiryDate     DateTime?
  nextDueDate    DateTime?
  outcome        StaffComplianceOutcome @default(PENDING)
  assessor       String?
  verifiedById   String?                @db.Uuid
  verifiedAt     DateTime?
  notes          String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  staffMember  StaffMember  @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  verifiedBy   User?        @relation("StaffComplianceVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([organisationId, type, outcome])
  @@index([staffMemberId, type])
  @@index([organisationId, expiryDate])
  @@index([organisationId, nextDueDate])
}

model EvidenceVersion {
  id            String   @id @default(uuid()) @db.Uuid
  evidenceId    String   @db.Uuid
  versionNumber String
  storageKey    String   @unique
  fileName      String
  contentType   String
  sizeBytes     Int
  checksum      String
  changeNotes   String?
  uploadedById  String   @db.Uuid
  createdAt     DateTime @default(now())

  evidence   Evidence  @relation("EvidenceVersions", fields: [evidenceId], references: [id], onDelete: Cascade)
  currentFor Evidence? @relation("CurrentEvidenceVersion")
  uploadedBy User      @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@unique([evidenceId, versionNumber])
  @@index([evidenceId, createdAt])
}

model Role {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique
  name        String
  description String
  isSystem    Boolean @default(true)

  memberships OrganisationMembership[]
  permissions RolePermission[]
}

model Permission {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique
  description String

  roles       RolePermission[]
  memberships MembershipPermission[]
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model OrganisationMembership {
  id                         String               @id @default(uuid()) @db.Uuid
  organisationId             String               @db.Uuid
  userId                     String               @db.Uuid
  roleId                     String               @db.Uuid
  status                     MembershipStatus     @default(INVITED)
  allLocations               Boolean              @default(false)
  accessMode                 MembershipAccessMode @default(STANDARD)
  jobTitle                   String?
  department                 String?
  reportsToId                String?              @db.Uuid
  permissionOverridesEnabled Boolean              @default(false)
  invitedAt                  DateTime             @default(now())
  joinedAt                   DateTime?
  deactivatedAt              DateTime?
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt

  organisation  Organisation             @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  user          User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  role          Role                     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  locations     MembershipLocation[]
  reportsTo     OrganisationMembership?  @relation("MembershipReportingLine", fields: [reportsToId], references: [id], onDelete: SetNull)
  directReports OrganisationMembership[] @relation("MembershipReportingLine")
  permissions   MembershipPermission[]

  @@unique([organisationId, userId])
  @@index([userId, status])
  @@index([organisationId, reportsToId])
}

model MembershipPermission {
  membershipId String @db.Uuid
  permissionId String @db.Uuid

  membership OrganisationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  permission Permission             @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([membershipId, permissionId])
  @@index([permissionId])
}

model MembershipLocation {
  membershipId String @db.Uuid
  locationId   String @db.Uuid

  membership OrganisationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  location   ServiceLocation        @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([membershipId, locationId])
  @@index([locationId])
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  userAgent  String?
  ipHash     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model ActivityLog {
  id             String         @id @default(uuid()) @db.Uuid
  organisationId String?        @db.Uuid
  locationId     String?        @db.Uuid
  userId         String?        @db.Uuid
  action         ActivityAction
  recordType     String
  recordId       String?
  summary        String
  beforeValue    Json?
  afterValue     Json?
  sessionInfo    String?
  createdAt      DateTime       @default(now())

  organisation Organisation?    @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  location     ServiceLocation? @relation(fields: [locationId], references: [id], onDelete: Restrict)
  user         User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organisationId, createdAt])
  @@index([recordType, recordId])
}
